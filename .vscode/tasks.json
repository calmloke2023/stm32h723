        {
            "label": "rtt print", // 不按 F5:先"download dap"烧录,再运行本任务,printf/LOGINFO 直接打印到终端
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/rtt_print.ps1",
            "problemMatcher": []
        },
